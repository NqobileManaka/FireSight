flowchart TD
  S(("●")) --> A["CAD system posts fire alert<br/>POST /api/v1/cad/alerts"]
  A --> B{"Valid token and role<br/>operator or admin?"}
  B -- "No" --> E1["Reject 401 / 403"] --> Z1(("◉"))
  B -- "Yes" --> C{"Payload valid<br/>(Pydantic)?"}
  C -- "No" --> E2["Reject 422"] --> Z1
  C -- "Yes" --> D{"callId already exists?"}
  D -- "Yes" --> E3["Reject 409 duplicate"] --> Z1
  D -- "No" --> F["Create incident INC-nnnn and notify dashboards"]
  F --> G{"Idle drone with<br/>battery at least 30%?"}
  G -- "No" --> H["Mark dispatch queued"] --> W["Wait until a drone becomes idle"] --> G
  G -- "Yes" --> I["Assign nearest drone,<br/>status en_route"]
  I --> J["Drone flies to incident,<br/>telemetry streamed at 10 Hz"]
  J --> K["Drone on scene at 80 m,<br/>stream thermal frames at 10 fps"]
  K --> L{"Frame is valid<br/>64x64 PNG?"}
  L -- "No" --> E4["Reject frame 422, keep streaming"] --> K
  L -- "Yes" --> M["CNN classifies frame"]
  M --> N{"Fire or Critical?"}
  N -- "No" --> K
  N -- "Yes" --> O["Segment and georeference hotspots,<br/>overlay on GIS map, refresh spread"]
  O --> P{"Critical severity?"}
  P -- "Yes" --> Q["Raise critical alert to commander"] --> R
  P -- "No" --> R["Commander directs crews<br/>via command channel"]
  R --> T{"Incident resolved and<br/>commander closes it?"}
  T -- "No" --> K
  T -- "Yes" --> U["Close incident, drone returns to idle"]
  U --> V["Generate post-incident report"]
  V --> Z2(("◉"))
